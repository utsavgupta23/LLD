public class BookingController {
    ConcurrentHashMap<Vehichle, List<Booking>> activeBookingMap = new ConcurrentHashMap<>();
    

    public List<Booking> getBooking(String vehicleId) {
        return activeBookingMap.getOrDefault(vehicleId, Collections.emptyList());
    }
    
    void addBooking(Booking booking){
         activeBookingMap.get(booking.getVehichle()).add(booking);
    }
    
    boolean checkAvialability(Vehichle vehichle, int startTime, int durationInMin ){
         boolean availability  = true;
         int newBookingEndTime = startTime + durationInMin;
         List<Booking> activeCurrVhichleBooking = activeBookingMap.get(vehichle);
               for(Booking currBooking : activeCurrVhichleBooking){
                   int currBookingStartTime = currBooking.getStartTime();
                   int currBookingEndTime = currBookingStartTime + currBooking.getDuration();

                // Overlap condition: (StartA < EndB) AND (StartB < EndA)
                     if (startTime < currBookingEndTime && currBookingStartTime < newBookingEndTime) {
                       availability = false;
                   }
                   if(!availability) break;
               }
               
               return availability;
    }
}

public interface LockingStrategy {
      Object lock(Vehichle vechicle);
      void unlock(Vehichle vehichle);
}

public class RedisLock implements LockingStrategy {
    
      private final Map<String, Object> vehicleLocks = ConcurrentHashMap<>();
        
        public Object lock(Vehichle vehichle){
              return vehicleLocks.computeIfAbsent(vehichle.getId(), k-> new Object());
        }
        
        public void unlock(Vehichle vehicle){
            vehicleLocks.remove(vehicle.getId());
        }
}


class CarRental {
    
    Map<String, List<Store>> cityStoreMap; // citycotroller
    BookingController bookingContorller = new BookingController();
    PaymentStrategy paymentStrategy = new UpiBookingStrategy(); 
    LockingStrategy lockstrategy  = new RedisLock();
    
    // 1. User selects city and get list of store
    List<Store> getCityWiseStores(String cityName){
        return cityStoreMap.get(cityName);
    }
    
    // 2. User selects nearest store and give duration of rent -> we should return all vechichles with availability
    // why not storign avilabily slots ? -> too much data to store unnecessay for every slot + booking data already avaialble
    List<Vehichle> getVechichle(Store store, int startTime, int durationInMin){
          List<Vehichle> allVehichles = store.getAllVehichles();
          List<Vehichle> allAvailableVehichle = new ArrayList<>();
          for( Vehichle currVehichle : allVehichles){
               if(bookingContorller.checkAvialability(currVehichle, startTime, durationInMin)) {
                   allAvailableVehichle.add(currVehichle);
               }
          }
          
          return allAvailableVehichle;
    }
    
    //3. User chose 1 vechichle and choses duration -> we give the booking id -> checkout page
    Booking bookVehichle (Vehichle vehichle, int startTime, int durationInMin ){
        Booking booking = new Booking(vehichle, startTime, durationInMin);
        return booking;
    }
    
    //4. User pays now and complete the booking -> pickup scheduled
    Booking payAndGetTheBooking (Booking booking){
        try {
        synchronized (lockstrategy.lock(booking.getVehichle())){ //since id is unique
            double fees = booking.fees();
            if(!bookingContorller.checkAvialability(booking.getVehichle(), booking.startTime, booking.getDuration())){
                // throw error booking not possible
            }
            Payment payment = paymentStrategy.processPayment(fees);
            booking.setPayment(payment);
            if(payment.paymentStatus == PaymentStatus.SUCCESS){
                booking.setStatus(BookingStatus.PICKUP_SCHEDULED);
                bookingContorller.addBooking(booking);   
            }else{
                booking.setStatus(BookingStatus.FAILED);
            }
            return booking;
        }
        } catch(Exception exception) {
            lockstrategy.unlock(booking.getVehichle());
        }

    }
    
    
