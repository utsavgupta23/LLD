interface RankingStrategy {
    Comparator<ItineraryActivity> getComparator();
}

class CostRankingStrategy implements RankingStrategy {
    @Override
    public Comparator<ItineraryActivity> getComparator() {
        // Ascending order: Lowest cost activity first
        return Comparator.comparingDouble(ItineraryActivity::getCost);
    }
}

class RatingRankingStrategy implements RankingStrategy {
    @Override
    public Comparator<ItineraryActivity> getComparator() {
        // Descending order: Highest rating activity first
        return Comparator.comparingDouble(ItineraryActivity::getRating).reversed();
    }
}

