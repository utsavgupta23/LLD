class RoomController {
    //wrong   Map<Room, List<Booking>> roomBookingMap;
    Map<Room, List<Meeting>> roomBookingMap;
    
    List<Room> getRooms(int capacity, int startTime, int endTime){
        List<Room> available = new ArrayList<>();
        
        roomBookingMap.forEach(room, bokinglist){
            bool isAvailable = true;
            if(room.occupany > capacity){
                for(Booking currBooking : bokinglist){
                  if(currBooking.startTime > startTime && currBooking.endTime<endTime){
                      isAvailable = false;
                  }       
             }
             if(isAvailable) available.add(room);
            }  
        }
        sort(available.begin(), available.end());
        return available;
    };
    
}


