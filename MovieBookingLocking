interface LockStrategy {
    boolean lock(List<ShowSeat> selectedSeats);
    void unlock(List<ShowSeat> selectedSeats);
}

class DBlock extends LcokStrategy{
    
    bool lockSeats(List<ShowSeat> selectedSeat){
        for(ShowSeat currSeat : selectedSeat){
            if(currSeat.getStatus() != SeatStatus.AVAILABLE){
                return false;
            }
        }
        
        for(ShowSeat currSeat : selectedSeat){
            currSeat.setStatus(SeatStatus.LOCKED);
        }
        return true;
    }
    
    void unlockSeat((List<ShowSeat> selectedSeat){
        for(ShowSeat currSeat : selectedSeat){
            if(currSeat.getStatus() != SeatStatus.BOOKED){
                currSeat.setStatus(SeatStatus.AVAILABLE);
            }
        }
        
    }
}

class InMemoryLockStrategy extends LockStrategy {
    
    ConcurrentHashMap<ShowSeat, Object> allLockedSeats;
    
    boolean lock (List<ShowSeat> seats){
         List<ShowSeat> lockedSeats = new ArrayList<>();;
        for(ShowSeat currSeat : seats){
            if(allLockedSeats.putIfAbsent(currSeat , new Object())){
                lockSeat.add(currSeat);
            }else{
                unlock(lockSeat);
                return false;
            }
        }
        return true;
    }
    
    void unlock(List<ShowSeat> seats){
        for(ShowSeat currSeat  : seats){
            lockSeat.remove(currSeat);
        }
    }
    
}

