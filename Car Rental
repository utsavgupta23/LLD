   class InMemoryLockStrategy implements LockStrategy {
        private final Map<String, Object> vehicleLocks = ConcurrentHashMap<>();
        
        public Object lock(Vehichle vehichle){
              return vechicleLocks.computeIfAbsent(vechicle.getVehichleId(), k-> new Object());
        }
        
        public void unlock(Vechichle vehicle){
            vechicleLocks.remove(vechicle.getVehichleId());
        }
   }


   
