List<Payment> simplify(
        Map<User, Map<User, Integer>> balances,
        List<User> members) {

    Map<User, Integer> netBalance = new HashMap<>();

    // 1. Calculate net balance of every user
    for (User user : members) {
        int net = 0;

        for (User other : members) {
            net += balances.get(user).get(other);
        }

        netBalance.put(user, net);
    }

    // 2. Separate creditors and debtors
    List<User> creditors = new ArrayList<>();
    List<User> debtors = new ArrayList<>();

    for (User user : members) {
        if (netBalance.get(user) > 0) {
            creditors.add(user);
        } else if (netBalance.get(user) < 0) {
            debtors.add(user);
        }
    }

    // 3. Match debtors with creditors
    List<Payment> result = new ArrayList<>();

    int i = 0;
    int j = 0;

    while (i < debtors.size() && j < creditors.size()) {

        User debtor = debtors.get(i);
        User creditor = creditors.get(j);

        int debt = -netBalance.get(debtor);
        int credit = netBalance.get(creditor);

        int amount = Math.min(debt, credit);

        result.add(new Payment(
                debtor,
                creditor,
                amount
        ));

        // debtor has paid his complete debt
        netBalance.put(
                debtor,
                netBalance.get(debtor) + amount
        );

        // creditor has received this amount
        netBalance.put(
                creditor,
                netBalance.get(creditor) - amount
        );

        if (netBalance.get(debtor) == 0) {
            i++;
        }

        if (netBalance.get(creditor) == 0) {
            j++;
        }
    }

    return result;
}



