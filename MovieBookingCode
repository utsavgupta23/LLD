class ShowSeat {
    String showId;
    String seatNo;
    double price;

    ShowSeatStatus status;
    String bookingId;
    long lockedUntil;

    boolean isAvailable(long currentTime) {
        if (status == ShowSeatStatus.AVAILABLE) {
            return true;
        }

        if (status == ShowSeatStatus.LOCKED &&
            currentTime >= lockedUntil) {
            return true;
        }

        return false;
    }
}

enum ShowSeatStatus {
    AVAILABLE,
    LOCKED,
    BOOKED
}

