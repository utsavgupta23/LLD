class ShowController {
     BookingController bookingController = new BookingController();
    
    
    boolean checkAvailability(List<ShowSeat> seats, int currentTime){
      
         for(ShowSeat seat : seats){
            if(!seat.isAvailable(currentTime)){
                return false;
            }
         }

         return true;
    }
}


interface LockStrategy {
    boolean lock(List<ShowSeat> seats);
    void unlock (List<ShowSeat> seats);
}

class InMemoryLockProvider implements LockStrategy {
    private final ConcurrentHashMap<String, ShowSeat> seatLocks = new ConcurrentHashMap<>();
    
    @Override
    public boolean lock(List<ShowSeat> seats) {
        List<ShowSeat> successfullyLocked = new ArrayList<>();
        
        for (ShowSeat showSeat : seats) {
            // Atomic check-and-set prevents Thread Race Conditions
            if (seatLocks.putIfAbsent(showSeat.showId + showSeat.showId, showSeat) == null) {
                successfullyLocked.add(showSeat);
            } else {
                // DEADLOCK PREVENTION: Rollback previously acquired locks
                unlock(successfullyLocked);
                return false; 
            }
        }
        return true;
    }
    
    @Override
    public void unlock(List<ShowSeat> seats) {
        for (ShowSeat showSeat : seats) {
            seatLocks.remove(showSeat.showId + showSeat.showId);
        }
    }
}


class MovieBookingSystem {
    Map<String, List<Theater>> cityTheaterMap;
    Map<Theater, List<Show>> theaterShowMap;
    BookingController bookingController;
    LockStrategy lockStrategy = new InMemoryLockProvider();
    ShowController showController;
    PaymentStrategy paymentStrategy = new UpiPaymentStrategy();
    // User selects city and movie -> getListofTheaterwithtimings
    
    Map<Theater, List<Show>> getAllShows(String cityName, Movie movie){
        Map<Theater, List<Show>> allLiveShows = new HashMap();
        List<Theater> theaterList = cityTheaterMap.get(cityName);
        for(Theater currTheater : theaterList){
                List<Show> allShows = theaterShowMap.get(currTheater);
                for(Show currShow : allShows){
                      if(currShow.getMovie() == movie){
                            allLiveShows.getOrDefault(currTheater, new ArrayList()).add(currShow);
                      }
                }
        }
        
        return allLiveShows;
    }
    
    
    //select show  -> list of avilable seat
    
    List<Seat> getAvailableSeats(Show show){
          List<Seat> seatMatrix = show.getScreen().getMatrix();
          List<Booking> bookings = bookingController.getActiveBooking(show);
          List<Seat> availableSeats = seatMatrix;
          
          for(Booking booking : bookings){
               availableSeats.remove(booking.getBookedSeat());
          }
          return availableSeats;
    }
    
    
    
    //selects seat and checkout -> Booking
    
    Booking bookSeat(List<ShowSeat> seats, Show show){
        double fees = 0;
        Booking currBooking = new Booking(show, seats);
        for(ShowSeat seat : seats){
            fees = fees + seat.price;
        }
        currBooking.fees = fees;
        return currBooking;
    }
    
    
    // pay -> ticket
    Booking confirmedBooking (Booking booking){
        
        if(!lockStrategy.lock(booking.getBookedSeat())){
            booking.setStatus(BookingStatus.FAILED);
            // runtimeexception
        }
        
        if(!showController.checkAvailability(booking.getBookedSeat(), 12000)){
            // already booked excepion
        }
        
        // mark showSeat as locked
        
        Payment payment = paymentStrategy.processPayment(booking.fees);
        booking.setPayment(payment);
        
        if(payment.getStatus() == PaymentStatus.SUCCESS){
            booking.setStatus(BookingStatus.COMPLETED);
            //show seat status as booked
        }else{
            booking.setStatus(BookingStatus.FAILED);
            //show seat status as avialble
        }
        
        return booking;
    } 
}










