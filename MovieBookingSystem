// 4. CORE ENGINE / ORCHESTRATOR
// ==========================================
class BookMyShow {
    private Map<City, List<Theater>> cityTheaterMap = new HashMap<>();
    private Map<Theater, List<Show>> theaterShowMap = new HashMap<>(); // Replaces DB queries
    
    private LockStrategy lockStrategy;
    private PaymentStrategy paymentStrategy;
    
    public BookMyShow(LockStrategy lockStrategy, PaymentStrategy paymentStrategy) {
        this.lockStrategy = lockStrategy;
        this.paymentStrategy = paymentStrategy;
    }
    
    // REQUIREMENT: Search shows by Movie and City
    public Map<Theater, List<Show>> searchShows(Movie movie, City city) {
        Map<Theater, List<Show>> result = new HashMap<>();
        List<Theater> theatersInCity = cityTheaterMap.getOrDefault(city, new ArrayList<>());
        
        for (Theater theater : theatersInCity) {
            List<Show> allShows = theaterShowMap.getOrDefault(theater, new ArrayList<>());
            List<Show> matchedShows = new ArrayList<>();
            
            // Apply Movie Filter
            for (Show show : allShows) {
                if (show.getMovie().getId() == movie.getId()) {
                    matchedShows.add(show);
                }
            }
            
            if (!matchedShows.isEmpty()) {
                result.put(theater, matchedShows);
            }
        }
        return result;
    }
    
    // REQUIREMENT: Book tickets with Concurrency handling
    public Booking bookTickets(User user, Show show, List<ShowSeat> selectedSeats) {
        // 1. Acquire Mutex (Fails fast if another thread holds the lock)
        if (!lockStrategy.lock(selectedSeats)) {
            throw new RuntimeException("Seats are currently being booked by someone else.");
        }
        
        try {
            // 2. Business Validation: Double-check that seats are actually vacant
            for (ShowSeat seat : selectedSeats) {
                if (seat.getStatus() != SeatStatus.VACANT) {
                    throw new RuntimeException("Seat is already booked.");
                }
            }
            
            // 3. Calculate price and mark Business State as LOCKED (Grey out on UI)
            double cost = 0;
            for (ShowSeat seat : selectedSeats) {
                cost += seat.getPrice();
                seat.setStatus(SeatStatus.LOCKED);
            }
            
            Booking booking = new Booking(user, show, selectedSeats, cost);
            
            // 4. Process Payment
            if (paymentStrategy.processPayment(cost)) {
                booking.setStatus(BookingStatus.CONFIRMED);
                for (ShowSeat seat : selectedSeats) {
                    seat.setStatus(SeatStatus.OCCUPIED); // Finalize business state
                }
                // Generate Ticket Receipt
                Ticket ticket = new Ticket(UUID.randomUUID().toString(), booking);
                booking.setTicket(ticket);
                
            } else {
                booking.setStatus(BookingStatus.FAILED);
                // BUSINESS STATE ROLLBACK: Free up seats for others
                for (ShowSeat seat : selectedSeats) {
                    seat.setStatus(SeatStatus.VACANT); 
                }
            }
            
            return booking;
            
        } finally {
            // 5. Always release the Mutex Lock
            lockStrategy.unlock(selectedSeats);
        }
    }
}
