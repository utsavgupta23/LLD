interface LockStrategy{
    void lock(List<ShowSeat> seats);
    void unlock(List<ShowSeat> seats);
}


class RedisLock implements LockStrategy {
    
    private final ConcurrentHashMap<String, ShowSeat> seatLocks = new ConcurrentHashMap<>();
   
    public boolean lock(List<ShowSeat> seats) {
        List<ShowSeat> successfullyLocked = new ArrayList<>();
        
        for (ShowSeat showSeat : seats) {
            // putIfAbsent is atomic! It prevents race conditions between two threads.
            if (seatLocks.putIfAbsent(showSeat.getShowSeatId(), showSeat) == null) {
                successfullyLocked.add(showSeat);
            } else {
                // LOCK FAILED! Someone else got this seat. We must rollback what we already locked.
                unlock(successfullyLocked);
                return false; 
            }
        }
        return true;
    }
    
    public void unlock(List<ShowSeat> seats) {
        for (ShowSeat showSeat : seats) {
            seatLocks.remove(showSeat.getShowSeatId());
        }
    }
}

